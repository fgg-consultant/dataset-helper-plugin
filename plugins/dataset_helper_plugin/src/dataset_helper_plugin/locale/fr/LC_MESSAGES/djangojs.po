# ── Clear provisioned ────────────────────────────────────────────────────────

msgid "Delete all Climweb Datasets that this plugin provisioned?"
msgstr "Supprimer tous les Datasets Climweb provisionnés par ce plugin ?"

msgid "Datasets created outside the plugin will be kept."
msgstr "Les Datasets créés en dehors du plugin seront conservés."

msgid "Catalog entries will be reset to pending_add."
msgstr "Les entrées du catalogue repasseront en pending_add."

msgid "This action cannot be undone."
msgstr "Cette action est irréversible."

msgid "Clearing…"
msgstr "Suppression…"

msgid "Catalog datasets cleared"
msgstr "Datasets du catalogue supprimés"

msgid "Datasets Deleted"
msgstr "Datasets supprimés"

msgid "Metadata Deleted"
msgstr "Métadonnées supprimées"

msgid "Empty SubCategories Swept"
msgstr "Sous-catégories vides nettoyées"

msgid "Empty Categories Swept"
msgstr "Catégories vides nettoyées"

msgid "Catalog Entries Reset"
msgstr "Entrées du catalogue réinitialisées"

msgid ""
"Datasets, SubCategories and Categories that did not come from this plugin "
"were preserved."
msgstr ""
"Les Datasets, sous-catégories et catégories non gérés par ce plugin ont été "
"conservés."

msgid "Refresh the page"
msgstr "Rafraîchir la page"

msgid "to see the updated state."
msgstr "pour voir l’état mis à jour."

msgid "Error"
msgstr "Erreur"

msgid "Clear failed"
msgstr "Échec de la suppression"

# ── Clear all ────────────────────────────────────────────────────────────────

msgid "Are you sure you want to delete ALL datasets, subcategories, and categories?"
msgstr "Êtes-vous sûr de vouloir supprimer TOUS les datasets, sous-catégories et catégories ?"

msgid "This action CANNOT be undone!"
msgstr "Cette action est IRRÉVERSIBLE !"

msgid "This is your LAST CHANCE to cancel."
msgstr "Dernière chance d’annuler."

msgid "Click OK to permanently delete all data, or Cancel to abort."
msgstr "Cliquez sur OK pour tout supprimer définitivement, ou Annuler pour interrompre."

msgid "Clearing..."
msgstr "Suppression…"

msgid "%(count)s item(s) could not be deleted:"
msgstr "%(count)s élément(s) n’ont pas pu être supprimés :"

msgid "Completed with some errors"
msgstr "Terminé avec quelques erreurs"

msgid "All data cleared successfully!"
msgstr "Toutes les données ont été supprimées avec succès !"

msgid "Categories Deleted"
msgstr "Catégories supprimées"

msgid "Subcategories Deleted"
msgstr "Sous-catégories supprimées"

msgid "WMS Layers Deleted"
msgstr "Couches WMS supprimées"

msgid "Clear All Datasets & Categories"
msgstr "Supprimer tous les Datasets & Catégories"

