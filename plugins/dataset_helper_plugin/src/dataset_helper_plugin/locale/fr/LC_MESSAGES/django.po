msgstr "Import WMS"

# ── CatalogEntry fields ──────────────────────────────────────────────────────

msgid "Product code"
msgstr "Code produit"

msgid ""
"Unique identifier. For config entries this comes from the CSV/JSON. For "
"manual/WMS entries it is auto-generated."
msgstr ""
"Identifiant unique. Pour les entrées de configuration, il provient du "
"CSV/JSON. Pour les entrées manuelles/WMS, il est généré automatiquement."

msgid "Title"
msgstr "Titre"

msgid "Layer type"
msgstr "Type de couche"

msgid "Category"
msgstr "Catégorie"

msgid "Subcategory"
msgstr "Sous-catégorie"

msgid "WMS layer name"
msgstr "Nom de la couche WMS"

msgid "Layer identifier as returned by WMS GetCapabilities"
msgstr "Identifiant de couche tel que renvoyé par WMS GetCapabilities"

msgid "WMS base URL"
msgstr "URL de base WMS"

msgid "Public"
msgstr "Public"

#, python-brace-format
msgid ""
"Propagated to Dataset.public. False for ECMWF private layers "
"(token={ECMWF_TOKEN} in config)."
msgstr ""
"Propagé vers Dataset.public. Faux pour les couches ECMWF privées "
"(token={ECMWF_TOKEN} en config)."

msgid "Extra WMS params"
msgstr "Paramètres WMS supplémentaires"

msgid "Additional query parameters for WMS requests (JSON object)"
msgstr "Paramètres de requête supplémentaires pour les requêtes WMS (objet JSON)"

msgid "Tile URL"
msgstr "URL des tuiles"

#, python-brace-format
msgid ""
"URL template with {z}/{x}/{y} placeholders, or a .pmtiles file URL when "
"is_pmtiles is set"
msgstr ""
"Modèle d’URL avec les placeholders {z}/{x}/{y}, ou URL d’un fichier "
".pmtiles si is_pmtiles est activé"

msgid "PMTiles format"
msgstr "Format PMTiles"

msgid ""
"For vector_tile layers: treat tile_url as a PMTiles archive URL instead of "
"an XYZ template"
msgstr ""
"Pour les couches vector_tile : considérer tile_url comme une URL d’archive "
"PMTiles plutôt qu’un modèle XYZ"

msgid "File URL"
msgstr "URL du fichier"

#, python-brace-format
msgid "URL to a remote file. May contain {country_alpha3} placeholder."
msgstr ""
"URL d’un fichier distant. Peut contenir le placeholder {country_alpha3}."

msgid "File bearer token"
msgstr "Bearer token pour le fichier"

msgid ""
"Optional bearer token sent as 'Authorization: Bearer …' when downloading "
"file_url (e.g. APIs that require auth)."
msgstr ""
"Bearer token optionnel envoyé en « Authorization: Bearer … » lors du "
"téléchargement de file_url (ex. APIs qui requièrent une authentification)."

msgid "COG URL template"
msgstr "Modèle d’URL COG"

msgid ""
"URL template with a time placeholder, e.g. https://example.org/data/"
"file_{time:%Y}.tif"
msgstr ""
"Modèle d’URL avec un placeholder temporel, ex. https://example.org/data/"
"file_{time:%Y}.tif"

msgid "COG time start"
msgstr "Début temporel COG"

msgid "COG time end"
msgstr "Fin temporelle COG"

msgid "COG time step value"
msgstr "Valeur du pas de temps COG"

msgid "COG time step unit"
msgstr "Unité du pas de temps COG"

msgid "One of: years, months, days, hours"
msgstr "L’une des valeurs : years, months, days, hours"

msgid "COG datetime display format"
msgstr "Format d’affichage de la date/heure COG"

msgid "Raster style"
msgstr "Style raster"

msgid ""
"Raster style definition: {min, max, steps, palette, interpolate, "
"legend_type, unit}"
msgstr ""
"Définition de style raster : {min, max, steps, palette, interpolate, "
"legend_type, unit}"

msgid "Render layers"
msgstr "Couches de rendu"

msgid "MapLibre GL style layer definitions (JSON array)"
msgstr "Définitions de style MapLibre GL des couches (tableau JSON)"

msgid "Popup config"
msgstr "Configuration de la popup"

msgid ""
"List of fields shown when a feature is clicked. Each item: {data_key, label, "
"data_type}."
msgstr ""
"Liste des champs affichés au clic sur un objet. Chaque élément : "
"{data_key, label, data_type}."

msgid "Enable popup"
msgstr "Activer la popup"

msgid "If checked, a popup will be displayed when clicking on the layer."
msgstr "Si coché, une popup s’affichera au clic sur la couche."

msgid "Load legend from WMS capabilities"
msgstr "Charger la légende depuis les capabilities WMS"

msgid ""
"If checked, the legend will be loaded from the WMS GetCapabilities response "
"(LegendURL)."
msgstr ""
"Si coché, la légende sera chargée depuis la réponse WMS GetCapabilities "
"(LegendURL)."

msgid "Legend"
msgstr "Légende"

msgid "Custom legend definition: {type, items: [{name, color}]}"
msgstr "Définition de légende personnalisée : {type, items: [{name, color}]}"

msgid "Initially visible on map"
msgstr "Visible sur la carte par défaut"

msgid "If set, the dataset is enabled on the map by default."
msgstr "Si activé, le dataset est affiché sur la carte par défaut."

msgid "Auto update interval (minutes)"
msgstr "Intervalle de mise à jour auto (minutes)"

msgid ""
"Auto-refresh interval for multi-temporal layers, in minutes. Leave empty to "
"disable auto-updating."
msgstr ""
"Intervalle de rafraîchissement automatique pour les couches multi-"
"temporelles, en minutes. Laisser vide pour désactiver."

msgid "Enabled"
msgstr "Activé"

msgid "Whether this entry should be provisioned in Climweb"
msgstr "Indique si cette entrée doit être provisionnée dans Climweb"

msgid "Climweb Dataset ID"
msgstr "ID du Dataset Climweb"

msgid "UUID of the corresponding Dataset in geomanager, if provisioned"
msgstr "UUID du Dataset correspondant dans geomanager, si provisionné"

msgid "Catalog content hash"
msgstr "Hash du contenu du catalogue"

msgid ""
"sha256 of catalog-derived fields at last load. Used to detect whether a re-"
"load actually changes anything for this entry."
msgstr ""
"sha256 des champs issus du catalogue au dernier chargement. Permet de "
"détecter si un re-chargement modifie réellement cette entrée."

msgid "Provisioned content hash"
msgstr "Hash du contenu provisionné"

msgid ""
"sha256 of the Climweb Dataset (+ related objects) the last time this entry "
"was provisioned or re-provisioned. Used to detect Wagtail admin edits that "
"diverge from the catalog."
msgstr ""
"sha256 du Dataset Climweb (+ objets liés) lors du dernier provisionnement "
"ou re-provisionnement de cette entrée. Permet de détecter les éditions "
"Wagtail qui s’écartent du catalogue."

msgid "Source hash at last sync"
msgstr "Hash source à la dernière synchronisation"

msgid ""
"Value of source_hash at the moment of the last successful sync. Used to "
"detect whether the catalog content has moved since the Climweb Dataset was "
"provisioned."
msgstr ""
"Valeur de source_hash au moment de la dernière synchronisation réussie. "
"Permet de détecter si le contenu du catalogue a changé depuis le "
"provisionnement du Dataset Climweb."

msgid "Category sort order"
msgstr "Ordre de tri des catégories"

msgid "Subcategory sort order"
msgstr "Ordre de tri des sous-catégories"

msgid "Entry sort order"
msgstr "Ordre de tri des entrées"

msgid "Catalog Entry"
msgstr "Entrée de catalogue"

msgid "Catalog Entries"
msgstr "Entrées de catalogue"

