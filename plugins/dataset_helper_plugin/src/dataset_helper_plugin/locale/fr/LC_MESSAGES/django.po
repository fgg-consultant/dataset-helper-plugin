msgstr "Catalogue de couches"

msgid "Danger Zone"
msgstr "Zone dangereuse"

msgid "Total Layers"
msgstr "Couches au total"

msgid "Synced"
msgstr "Synchronisées"

msgid "Review changes"
msgstr "Revoir les changements"

