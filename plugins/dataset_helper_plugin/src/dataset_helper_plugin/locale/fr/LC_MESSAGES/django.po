# ── models.py / PluginSettings ───────────────────────────────────────────────

msgid "Language"
msgstr "Langue"

msgid "Language for imported catalog labels"
msgstr "Langue pour les libellés du catalogue importé"

msgid "ECMWF API Token"
msgstr "Token API ECMWF"

#, python-brace-format
msgid ""
"Token for ECMWF eccharts WMS service. Leave empty to keep public layers "
"using token=public and skip private layers (token={ECMWF_TOKEN})."
msgstr ""
"Token pour le service WMS ECMWF eccharts. Laissez vide pour ne garder que "
"les couches publiques (token=public) et ignorer les couches privées "
"(token={ECMWF_TOKEN})."

msgid "Local eStation URL"
msgstr "URL eStation locale"

msgid ""
"If set, only eStation products available on this local instance will be "
"imported"
msgstr ""
"Si renseigné, seuls les produits eStation disponibles sur cette instance "
"locale seront importés"

msgid "Country code (alpha-3)"
msgstr "Code pays (alpha-3)"

msgid ""
"ISO 3166-1 alpha-3 country code used for URL placeholder substitution (e.g. "
"bfa)"
msgstr ""
"Code pays ISO 3166-1 alpha-3 utilisé pour la substitution dans les URL (ex. "
"bfa)"

msgid "Country code (alpha-2)"
msgstr "Code pays (alpha-2)"

msgid ""
"ISO 3166-1 alpha-2 country code used for URL placeholder substitution (e.g. "
"bf)"
msgstr ""
"Code pays ISO 3166-1 alpha-2 utilisé pour la substitution dans les URL (ex. "
"bf)"

msgid "Country name"
msgstr "Nom du pays"

msgid "Official country name from OpenStreetMap Nominatim (display_name)"
msgstr "Nom officiel du pays d’après OpenStreetMap Nominatim (display_name)"

msgid "Country bounding box"
msgstr "Bounding box du pays"

msgid ""
"Nominatim country bounding box as [south, north, west, east] of decimal "
"degrees"
msgstr ""
"Bounding box du pays d’après Nominatim, sous la forme [sud, nord, ouest, "
"est] en degrés décimaux"

msgid "Plugin Settings"
msgstr "Paramètres du plugin"

msgid "Loaded catalog version"
msgstr "Version du catalogue chargée"

msgid "Loaded catalog schema version"
msgstr "Version de schéma du catalogue chargée"

msgid "Last load timestamp"
msgstr "Date du dernier chargement"

msgid "Catalog State"
msgstr "État du catalogue"

