msgid "WMS"
msgstr "WMS"

msgid "Raster Tile"
msgstr "Tuile raster"

msgid "Vector Tile"
msgstr "Tuile vectorielle"

msgid "Raster File"
msgstr "Fichier raster"

msgid "Vector File"
msgstr "Fichier vectoriel"

msgid "Raster COG"
msgstr "Raster COG"

