msgstr "Título do dataset"

msgid "WMS Layer Name"
msgstr "Nome da camada WMS"

msgid "WMS LAYERS parameter"
msgstr "Parâmetro WMS LAYERS"

msgid "WMS Base URL"
msgstr "URL base WMS"

msgid "Source"
msgstr "Fonte"

msgid "Data provider"
msgstr "Fornecedor de dados"

msgid "Resolution"
msgstr "Resolução"

msgid "e.g. 1km"
msgstr "ex. 1 km"

msgid "Add"
msgstr "Adicionar"

msgid "Cancel"
msgstr "Cancelar"

