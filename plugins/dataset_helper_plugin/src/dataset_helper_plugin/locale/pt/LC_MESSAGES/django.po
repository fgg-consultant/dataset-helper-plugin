# ── models.py / PluginSettings ───────────────────────────────────────────────

msgid "Language"
msgstr "Idioma"

msgid "Language for imported catalog labels"
msgstr "Idioma para os rótulos do catálogo importado"

msgid "ECMWF API Token"
msgstr "Token API ECMWF"

#, python-brace-format
msgid ""
"Token for ECMWF eccharts WMS service. Leave empty to keep public layers "
"using token=public and skip private layers (token={ECMWF_TOKEN})."
msgstr ""
"Token para o serviço WMS ECMWF eccharts. Deixe vazio para manter apenas as "
"camadas públicas (token=public) e ignorar as camadas privadas "
"(token={ECMWF_TOKEN})."

msgid "Local eStation URL"
msgstr "URL eStation local"

msgid ""
"If set, only eStation products available on this local instance will be "
"imported"
msgstr ""
"Se definido, apenas os produtos eStation disponíveis nesta instância local "
"serão importados"

msgid "Country code (alpha-3)"
msgstr "Código de país (alpha-3)"

msgid ""
"ISO 3166-1 alpha-3 country code used for URL placeholder substitution (e.g. "
"bfa)"
msgstr ""
"Código de país ISO 3166-1 alpha-3 usado para substituição em URLs (ex. bfa)"

msgid "Country code (alpha-2)"
msgstr "Código de país (alpha-2)"

msgid ""
"ISO 3166-1 alpha-2 country code used for URL placeholder substitution (e.g. "
"bf)"
msgstr ""
"Código de país ISO 3166-1 alpha-2 usado para substituição em URLs (ex. bf)"

msgid "Country name"
msgstr "Nome do país"

msgid "Official country name from OpenStreetMap Nominatim (display_name)"
msgstr "Nome oficial do país segundo OpenStreetMap Nominatim (display_name)"

msgid "Country bounding box"
msgstr "Bounding box do país"

msgid ""
"Nominatim country bounding box as [south, north, west, east] of decimal "
"degrees"
msgstr ""
"Bounding box do país segundo Nominatim como [sul, norte, oeste, leste] em "
"graus decimais"

msgid "Plugin Settings"
msgstr "Configurações do plugin"

msgid "Loaded catalog version"
msgstr "Versão do catálogo carregada"

msgid "Loaded catalog schema version"
msgstr "Versão do esquema do catálogo carregada"

msgid "Last load timestamp"
msgstr "Data do último carregamento"

msgid "Catalog State"
msgstr "Estado do catálogo"

# ── CatalogEntry choices ─────────────────────────────────────────────────────

msgid "WMS"
msgstr "WMS"

msgid "Raster Tile"
msgstr "Tile raster"

msgid "Vector Tile"
msgstr "Tile vetorial"

msgid "Raster File"
msgstr "Ficheiro raster"

msgid "Vector File"
msgstr "Ficheiro vetorial"

msgid "Raster COG"
msgstr "Raster COG"

msgid "From configuration"
msgstr "Da configuração"

msgid "Manually added"
msgstr "Adicionado manualmente"

msgid "WMS import"
msgstr "Importação WMS"

# ── CatalogEntry fields ──────────────────────────────────────────────────────

msgid "Product code"
msgstr "Código do produto"

msgid ""
"Unique identifier. For config entries this comes from the CSV/JSON. For "
"manual/WMS entries it is auto-generated."
msgstr ""
"Identificador único. Para entradas de configuração vem do CSV/JSON. Para "
"entradas manuais/WMS é gerado automaticamente."

msgid "Title"
msgstr "Título"

msgid "Layer type"
msgstr "Tipo de camada"

msgid "Category"
msgstr "Categoria"

msgid "Subcategory"
msgstr "Subcategoria"

msgid "WMS layer name"
msgstr "Nome da camada WMS"

msgid "Layer identifier as returned by WMS GetCapabilities"
msgstr "Identificador de camada devolvido por WMS GetCapabilities"

msgid "WMS base URL"
msgstr "URL base WMS"

msgid "Public"
msgstr "Público"

#, python-brace-format
msgid ""
"Propagated to Dataset.public. False for ECMWF private layers "
"(token={ECMWF_TOKEN} in config)."
msgstr ""
"Propagado para Dataset.public. Falso para as camadas privadas ECMWF "
"(token={ECMWF_TOKEN} em config)."

msgid "Extra WMS params"
msgstr "Parâmetros WMS adicionais"

msgid "Additional query parameters for WMS requests (JSON object)"
msgstr ""
"Parâmetros adicionais para as solicitações WMS (objeto JSON)"

msgid "Tile URL"
msgstr "URL dos tiles"

#, python-brace-format
msgid ""
"URL template with {z}/{x}/{y} placeholders, or a .pmtiles file URL when "
"is_pmtiles is set"
msgstr ""
"Modelo de URL com os marcadores {z}/{x}/{y}, ou URL de um ficheiro "
".pmtiles quando is_pmtiles está ativado"

msgid "PMTiles format"
msgstr "Formato PMTiles"

msgid ""
"For vector_tile layers: treat tile_url as a PMTiles archive URL instead of "
"an XYZ template"
msgstr ""
"Para camadas vector_tile: tratar tile_url como uma URL de arquivo PMTiles "
"em vez de um modelo XYZ"

msgid "File URL"
msgstr "URL do ficheiro"

#, python-brace-format
msgid "URL to a remote file. May contain {country_alpha3} placeholder."
msgstr ""
"URL de um ficheiro remoto. Pode conter o marcador {country_alpha3}."

msgid "File bearer token"
msgstr "Bearer token do ficheiro"

msgid ""
"Optional bearer token sent as 'Authorization: Bearer …' when downloading "
"file_url (e.g. APIs that require auth)."
msgstr ""
"Bearer token opcional enviado como «Authorization: Bearer …» ao "
"descarregar file_url (ex. APIs que requerem autenticação)."

msgid "COG URL template"
msgstr "Modelo de URL COG"

msgid ""
"URL template with a time placeholder, e.g. https://example.org/data/"
"file_{time:%Y}.tif"
msgstr ""
"Modelo de URL com um marcador temporal, ex. https://example.org/data/"
"file_{time:%Y}.tif"

msgid "COG time start"
msgstr "Início temporal COG"

msgid "COG time end"
msgstr "Fim temporal COG"

msgid "COG time step value"
msgstr "Valor do passo temporal COG"

msgid "COG time step unit"
msgstr "Unidade do passo temporal COG"

msgid "One of: years, months, days, hours"
msgstr "Um dos valores: years, months, days, hours"

msgid "COG datetime display format"
msgstr "Formato de exibição de data/hora COG"

msgid "Raster style"
msgstr "Estilo raster"

msgid ""
"Raster style definition: {min, max, steps, palette, interpolate, "
"legend_type, unit}"
msgstr ""
"Definição de estilo raster: {min, max, steps, palette, interpolate, "
"legend_type, unit}"

msgid "Render layers"
msgstr "Camadas de renderização"

msgid "MapLibre GL style layer definitions (JSON array)"
msgstr "Definições de estilo MapLibre GL das camadas (array JSON)"

msgid "Popup config"
msgstr "Configuração do popup"

msgid ""
"List of fields shown when a feature is clicked. Each item: {data_key, label, "
"data_type}."
msgstr ""
"Lista de campos exibidos ao clicar num objeto. Cada item: {data_key, "
"label, data_type}."

msgid "Enable popup"
msgstr "Ativar popup"

msgid "If checked, a popup will be displayed when clicking on the layer."
msgstr "Se marcado, um popup será exibido ao clicar na camada."

msgid "Load legend from WMS capabilities"
msgstr "Carregar legenda a partir das capabilities WMS"

msgid ""
"If checked, the legend will be loaded from the WMS GetCapabilities response "
"(LegendURL)."
msgstr ""
"Se marcado, a legenda será carregada a partir da resposta WMS "
"GetCapabilities (LegendURL)."

msgid "Legend"
msgstr "Legenda"

msgid "Custom legend definition: {type, items: [{name, color}]}"
msgstr "Definição de legenda personalizada: {type, items: [{name, color}]}"

msgid "Initially visible on map"
msgstr "Visível no mapa por defeito"

msgid "If set, the dataset is enabled on the map by default."
msgstr "Se ativado, o dataset é exibido no mapa por defeito."

msgid "Auto update interval (minutes)"
msgstr "Intervalo de atualização automática (minutos)"

msgid ""
"Auto-refresh interval for multi-temporal layers, in minutes. Leave empty to "
"disable auto-updating."
msgstr ""
"Intervalo de atualização automática para camadas multi-temporais, em "
"minutos. Deixe vazio para desativar."

msgid "Enabled"
msgstr "Ativado"

msgid "Whether this entry should be provisioned in Climweb"
msgstr "Indica se esta entrada deve ser provisionada no Climweb"

msgid "Climweb Dataset ID"
msgstr "ID do Dataset Climweb"

msgid "UUID of the corresponding Dataset in geomanager, if provisioned"
msgstr ""
"UUID do Dataset correspondente no geomanager, se provisionado"

msgid "Catalog content hash"
msgstr "Hash do conteúdo do catálogo"

msgid ""
"sha256 of catalog-derived fields at last load. Used to detect whether a re-"
"load actually changes anything for this entry."
msgstr ""
"sha256 dos campos do catálogo no último carregamento. Permite detetar se "
"um novo carregamento altera realmente esta entrada."

msgid "Provisioned content hash"
msgstr "Hash do conteúdo provisionado"

msgid ""
"sha256 of the Climweb Dataset (+ related objects) the last time this entry "
"was provisioned or re-provisioned. Used to detect Wagtail admin edits that "
"diverge from the catalog."
msgstr ""
"sha256 do Dataset Climweb (+ objetos relacionados) na última vez em que "
"esta entrada foi provisionada ou re-provisionada. Permite detetar edições "
"do Wagtail que divergem do catálogo."

msgid "Source hash at last sync"
msgstr "Hash da fonte na última sincronização"

msgid ""
"Value of source_hash at the moment of the last successful sync. Used to "
"detect whether the catalog content has moved since the Climweb Dataset was "
"provisioned."
msgstr ""
"Valor de source_hash no momento da última sincronização bem-sucedida. "
"Permite detetar se o conteúdo do catálogo mudou desde o provisionamento "
"do Dataset Climweb."

msgid "Category sort order"
msgstr "Ordem das categorias"

msgid "Subcategory sort order"
msgstr "Ordem das subcategorias"

msgid "Entry sort order"
msgstr "Ordem das entradas"

msgid "Catalog Entry"
msgstr "Entrada do catálogo"

msgid "Catalog Entries"
msgstr "Entradas do catálogo"

