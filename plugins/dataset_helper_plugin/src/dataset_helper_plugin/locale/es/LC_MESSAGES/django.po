# ── models.py / PluginSettings ───────────────────────────────────────────────

msgid "Language"
msgstr "Idioma"

msgid "Language for imported catalog labels"
msgstr "Idioma para las etiquetas del catálogo importado"

msgid "ECMWF API Token"
msgstr "Token API ECMWF"

#, python-brace-format
msgid ""
"Token for ECMWF eccharts WMS service. Leave empty to keep public layers "
"using token=public and skip private layers (token={ECMWF_TOKEN})."
msgstr ""
"Token para el servicio WMS ECMWF eccharts. Dejar vacío para mantener solo "
"las capas públicas (token=public) y omitir las capas privadas "
"(token={ECMWF_TOKEN})."

msgid "Local eStation URL"
msgstr "URL de eStation local"

msgid ""
"If set, only eStation products available on this local instance will be "
"imported"
msgstr ""
"Si está definido, solo se importarán los productos eStation disponibles en "
"esta instancia local"

msgid "Country code (alpha-3)"
msgstr "Código de país (alpha-3)"

msgid ""
"ISO 3166-1 alpha-3 country code used for URL placeholder substitution (e.g. "
"bfa)"
msgstr ""
"Código de país ISO 3166-1 alpha-3 usado para la sustitución en URLs (p. ej. "
"bfa)"

msgid "Country code (alpha-2)"
msgstr "Código de país (alpha-2)"

msgid ""
"ISO 3166-1 alpha-2 country code used for URL placeholder substitution (e.g. "
"bf)"
msgstr ""
"Código de país ISO 3166-1 alpha-2 usado para la sustitución en URLs (p. ej. "
"bf)"

msgid "Country name"
msgstr "Nombre del país"

msgid "Official country name from OpenStreetMap Nominatim (display_name)"
msgstr "Nombre oficial del país según OpenStreetMap Nominatim (display_name)"

msgid "Country bounding box"
msgstr "Bounding box del país"

msgid ""
"Nominatim country bounding box as [south, north, west, east] of decimal "
"degrees"
msgstr ""
"Bounding box del país según Nominatim como [sur, norte, oeste, este] en "
"grados decimales"

msgid "Plugin Settings"
msgstr "Configuración del plugin"

msgid "Loaded catalog version"
msgstr "Versión del catálogo cargada"

msgid "Loaded catalog schema version"
msgstr "Versión del esquema del catálogo cargada"

msgid "Last load timestamp"
msgstr "Fecha de la última carga"

msgid "Catalog State"
msgstr "Estado del catálogo"

# ── CatalogEntry choices ─────────────────────────────────────────────────────

msgid "WMS"
msgstr "WMS"

msgid "Raster Tile"
msgstr "Tesela raster"

msgid "Vector Tile"
msgstr "Tesela vectorial"

msgid "Raster File"
msgstr "Archivo raster"

msgid "Vector File"
msgstr "Archivo vectorial"

msgid "Raster COG"
msgstr "Raster COG"

msgid "From configuration"
msgstr "Desde la configuración"

msgid "Manually added"
msgstr "Añadido manualmente"

msgid "WMS import"
msgstr "Importación WMS"

# ── CatalogEntry fields ──────────────────────────────────────────────────────

msgid "Product code"
msgstr "Código de producto"

msgid ""
"Unique identifier. For config entries this comes from the CSV/JSON. For "
"manual/WMS entries it is auto-generated."
msgstr ""
"Identificador único. Para entradas de configuración proviene del CSV/JSON. "
"Para entradas manuales/WMS se genera automáticamente."

msgid "Title"
msgstr "Título"

msgid "Layer type"
msgstr "Tipo de capa"

msgid "Category"
msgstr "Categoría"

msgid "Subcategory"
msgstr "Subcategoría"

msgid "WMS layer name"
msgstr "Nombre de la capa WMS"

msgid "Layer identifier as returned by WMS GetCapabilities"
msgstr "Identificador de capa devuelto por WMS GetCapabilities"

msgid "WMS base URL"
msgstr "URL base WMS"

msgid "Public"
msgstr "Público"

#, python-brace-format
msgid ""
"Propagated to Dataset.public. False for ECMWF private layers "
"(token={ECMWF_TOKEN} in config)."
msgstr ""
"Propagado a Dataset.public. Falso para las capas privadas ECMWF "
"(token={ECMWF_TOKEN} en config)."

msgid "Extra WMS params"
msgstr "Parámetros WMS adicionales"

msgid "Additional query parameters for WMS requests (JSON object)"
msgstr "Parámetros adicionales para las solicitudes WMS (objeto JSON)"

msgid "Tile URL"
msgstr "URL de teselas"

#, python-brace-format
msgid ""
"URL template with {z}/{x}/{y} placeholders, or a .pmtiles file URL when "
"is_pmtiles is set"
msgstr ""
"Plantilla de URL con los marcadores {z}/{x}/{y}, o URL de un archivo "
".pmtiles si is_pmtiles está activado"

msgid "PMTiles format"
msgstr "Formato PMTiles"

msgid ""
"For vector_tile layers: treat tile_url as a PMTiles archive URL instead of "
"an XYZ template"
msgstr ""
"Para capas vector_tile: tratar tile_url como una URL de archivo PMTiles en "
"lugar de una plantilla XYZ"

msgid "File URL"
msgstr "URL del archivo"

#, python-brace-format
msgid "URL to a remote file. May contain {country_alpha3} placeholder."
msgstr ""
"URL de un archivo remoto. Puede contener el marcador {country_alpha3}."

msgid "File bearer token"
msgstr "Bearer token del archivo"

msgid ""
"Optional bearer token sent as 'Authorization: Bearer …' when downloading "
"file_url (e.g. APIs that require auth)."
msgstr ""
"Bearer token opcional enviado como «Authorization: Bearer …» al descargar "
"file_url (p. ej. APIs que requieren autenticación)."

msgid "COG URL template"
msgstr "Plantilla de URL COG"

msgid ""
"URL template with a time placeholder, e.g. https://example.org/data/"
"file_{time:%Y}.tif"
msgstr ""
"Plantilla de URL con un marcador temporal, p. ej. https://example.org/data/"
"file_{time:%Y}.tif"

msgid "COG time start"
msgstr "Inicio temporal COG"

msgid "COG time end"
msgstr "Fin temporal COG"

msgid "COG time step value"
msgstr "Valor del paso temporal COG"

msgid "COG time step unit"
msgstr "Unidad del paso temporal COG"

msgid "One of: years, months, days, hours"
msgstr "Uno de: years, months, days, hours"

msgid "COG datetime display format"
msgstr "Formato de visualización de fecha/hora COG"

msgid "Raster style"
msgstr "Estilo raster"

msgid ""
"Raster style definition: {min, max, steps, palette, interpolate, "
"legend_type, unit}"
msgstr ""
"Definición de estilo raster: {min, max, steps, palette, interpolate, "
"legend_type, unit}"

msgid "Render layers"
msgstr "Capas de renderizado"

msgid "MapLibre GL style layer definitions (JSON array)"
msgstr "Definiciones de estilo MapLibre GL de las capas (matriz JSON)"

msgid "Popup config"
msgstr "Configuración del popup"

msgid ""
"List of fields shown when a feature is clicked. Each item: {data_key, label, "
"data_type}."
msgstr ""
"Lista de campos mostrados al hacer clic en un objeto. Cada elemento: "
"{data_key, label, data_type}."

msgid "Enable popup"
msgstr "Activar popup"

msgid "If checked, a popup will be displayed when clicking on the layer."
msgstr "Si está marcado, se mostrará un popup al hacer clic en la capa."

msgid "Load legend from WMS capabilities"
msgstr "Cargar leyenda desde las capabilities WMS"

msgid ""
"If checked, the legend will be loaded from the WMS GetCapabilities response "
"(LegendURL)."
msgstr ""
"Si está marcado, la leyenda se cargará desde la respuesta WMS "
"GetCapabilities (LegendURL)."

msgid "Legend"
msgstr "Leyenda"

msgid "Custom legend definition: {type, items: [{name, color}]}"
msgstr "Definición de leyenda personalizada: {type, items: [{name, color}]}"

msgid "Initially visible on map"
msgstr "Visible en el mapa por defecto"

msgid "If set, the dataset is enabled on the map by default."
msgstr "Si está activado, el dataset se muestra en el mapa por defecto."

msgid "Auto update interval (minutes)"
msgstr "Intervalo de actualización automática (minutos)"

msgid ""
"Auto-refresh interval for multi-temporal layers, in minutes. Leave empty to "
"disable auto-updating."
msgstr ""
"Intervalo de auto-actualización para capas multi-temporales, en minutos. "
"Dejar vacío para desactivar."

msgid "Enabled"
msgstr "Activado"

msgid "Whether this entry should be provisioned in Climweb"
msgstr "Indica si esta entrada debe provisionarse en Climweb"

msgid "Climweb Dataset ID"
msgstr "ID del Dataset Climweb"

msgid "UUID of the corresponding Dataset in geomanager, if provisioned"
msgstr "UUID del Dataset correspondiente en geomanager, si está provisionado"

msgid "Catalog content hash"
msgstr "Hash del contenido del catálogo"

msgid ""
"sha256 of catalog-derived fields at last load. Used to detect whether a re-"
"load actually changes anything for this entry."
msgstr ""
"sha256 de los campos del catálogo en la última carga. Permite detectar si "
"una recarga modifica realmente esta entrada."

msgid "Provisioned content hash"
msgstr "Hash del contenido provisionado"

msgid ""
"sha256 of the Climweb Dataset (+ related objects) the last time this entry "
"was provisioned or re-provisioned. Used to detect Wagtail admin edits that "
"diverge from the catalog."
msgstr ""
"sha256 del Dataset Climweb (+ objetos relacionados) la última vez que esta "
"entrada fue provisionada o reprovisionada. Permite detectar las ediciones "
"de Wagtail que divergen del catálogo."

msgid "Source hash at last sync"
msgstr "Hash fuente en la última sincronización"

msgid ""
"Value of source_hash at the moment of the last successful sync. Used to "
"detect whether the catalog content has moved since the Climweb Dataset was "
"provisioned."
msgstr ""
"Valor de source_hash en el momento de la última sincronización exitosa. "
"Permite detectar si el contenido del catálogo ha cambiado desde el "
"aprovisionamiento del Dataset Climweb."

msgid "Category sort order"
msgstr "Orden de las categorías"

msgid "Subcategory sort order"
msgstr "Orden de las subcategorías"

msgid "Entry sort order"
msgstr "Orden de las entradas"

msgid "Catalog Entry"
msgstr "Entrada del catálogo"

msgid "Catalog Entries"
msgstr "Entradas del catálogo"

