msgstr "Catálogo de capas"

msgid "Danger Zone"
msgstr "Zona peligrosa"

msgid "Total Layers"
msgstr "Capas totales"

msgid "Synced"
msgstr "Sincronizadas"

msgid "Review changes"
msgstr "Revisar los cambios"

msgid "Settings"
msgstr "Configuración"

msgid "required setting missing"
msgstr "falta una configuración obligatoria"

msgid "ECMWF Token"
msgstr "Token ECMWF"

msgid "(leave empty for public-only)"
msgstr "(dejar vacío para solo capas públicas)"

#, python-brace-format
msgid ""
"Token for eccharts.ecmwf.int. Empty = public layers only; private layers "
"(token={ECMWF_TOKEN}) are skipped."
msgstr ""
"Token para eccharts.ecmwf.int. Vacío = solo capas públicas; las capas "
"privadas (token={ECMWF_TOKEN}) se omiten."

msgid "Leave empty to import all eStation products"
msgstr "Dejar vacío para importar todos los productos eStation"

msgid "Country"
msgstr "País"

